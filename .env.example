# ── Coworker OS environment ────────────────────────────────────────────
# Every value here is OPTIONAL. With nothing set, the system runs entirely
# on local Ollama (free) and an in-process embedder fallback (free).

# Runtime
COWORKER_ENV=dev
COWORKER_HOST=0.0.0.0
COWORKER_PORT=8000
COWORKER_LOG_LEVEL=INFO

# Master encryption key for connector credentials.
# If unset, one will be auto-generated and persisted at data/.master_key.
# COWORKER_MASTER_KEY=

# ── Free cloud AI providers (all optional) ─────────────────────────────
# Get free Gemini key at: https://aistudio.google.com/apikey
COWORKER_GEMINI_API_KEY=

# Free OpenRouter at: https://openrouter.ai/
COWORKER_OPENROUTER_API_KEY=

# DeepSeek (offers free credits): https://platform.deepseek.com/
COWORKER_DEEPSEEK_API_KEY=

# HuggingFace Inference (free): https://huggingface.co/settings/tokens
COWORKER_HUGGINGFACE_API_KEY=

# ── Local Ollama (always free) ─────────────────────────────────────────
COWORKER_OLLAMA_BASE_URL=http://localhost:11434
COWORKER_OLLAMA_DEFAULT_CHAT_MODEL=qwen2.5:3b
COWORKER_OLLAMA_DEFAULT_CODE_MODEL=qwen2.5-coder:7b
COWORKER_OLLAMA_DEFAULT_REASON_MODEL=qwen2.5:14b

# ── Soft daily caps to protect free tiers ──────────────────────────────
COWORKER_DAILY_CLOUD_TOKEN_CAP=200000
COWORKER_DAILY_CLOUD_REQUEST_CAP=1000

# ── Approval policy ────────────────────────────────────────────────────
# Read-only and pure-compute work auto-approves by default. Anything that
# mutates external systems or spends money requires a human click.
COWORKER_AUTO_APPROVE_READ_ONLY=true
COWORKER_AUTO_APPROVE_INTERNAL_MUTATIONS=false
COWORKER_AUTO_APPROVE_EXTERNAL_MUTATIONS=false
COWORKER_AUTO_APPROVE_SPEND=false

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated; defaults already include localhost:5173 + 3000.
# COWORKER_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
